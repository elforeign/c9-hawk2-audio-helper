#!/bin/sh
# A pending durable recovery must run even when startup application is disabled.
D=/var/lib/glasshouse-c9-edid
[ -f "$D/enabled" ] || [ -f "$D/operation.json" ] || [ -f "$D/disable-requested" ] || exit 0
mkdir -p /tmp/glasshouse-c9-edid
chmod 700 /tmp/glasshouse-c9-edid
nohup /usr/bin/python -B "$D/service.py" daemon </dev/null >/tmp/glasshouse-c9-edid/service.log 2>&1 &
exit 0
